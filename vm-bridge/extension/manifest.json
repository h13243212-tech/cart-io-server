{
  "manifest_version": 3,
  "name": "Arena ⇄ VM Bridge",
  "version": "0.1.0",
  "description": "Run shell commands on your own VM from a browser tab, through a token-authenticated local bridge.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arena ⇄ VM Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/*",
        "https://*.arena.ai/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
