{
  "manifest_version": 3,
  "name": "Arena ⇄ Kali",
  "version": "0.4.0",
  "description": "Lets an Arena Direct-mode chat run commands on your own Kali VM, by simulating the tool loop through the chat UI.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arena ⇄ Kali"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/*",
        "https://*.arena.ai/*"
      ],
      "js": [
        "site.js",
        "prompt.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
